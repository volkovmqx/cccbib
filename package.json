{
  "name": "org.webosbrew.cccbib",
  "version": "1.2.0",
  "description": "media.ccc.de library application (EXPERIMENTAL)",
  "scripts": {
    "start": "webpack serve --config ./webpack.config.js --mode development",
    "test": "vitest run",
    "build": "node tools/check-i18n.js && webpack --config ./webpack.config.js --mode production && node tools/check-syntax.js",
    "package": "ares-package --no-minify dist/",
    "deploy": "ares-install ${npm_package_name}_${npm_package_version}_all.ipk",
    "launch": "ares-launch ${npm_package_name}",
    "manifest": "node tools/gen-manifest.js ${npm_package_name}.manifest.json",
    "version": "node tools/sync-version.js && git add assets/appinfo.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint:fsd": "steiger src --fail-on-warnings",
    "lint:unused": "knip && knip --production",
    "test:e2e": "playwright test",
    "test:chrome68": "node tests/browser/chrome68.cjs",
    "setup:webos": "node tools/setup-webos-simulator.cjs",
    "test:webos": "playwright test --config playwright.webos.config.mts",
    "verify": "yarn typecheck && yarn lint:fsd && yarn lint:unused && yarn test:coverage && yarn build && yarn test:e2e && yarn test:chrome68"
  },
  "keywords": [],
  "author": "volkovmqx",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@webosose/ares-cli": "^2.2.0",
    "acorn": "^8.17.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "puppeteer-core": "1.8.0",
    "steiger": "^0.7.0",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.7"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.49.0",
    "core-js": "^3.50.0",
    "embla-carousel-react": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
